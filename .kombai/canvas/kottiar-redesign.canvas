      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n</style>\n\n<div style=\"font-family: 'Plus Jakarta Sans', sans-serif; display: flex; min-height: 860px; background: #0d0d1a;\" data-kid=\"1\">\n\n  \n  <div style=\"width: 55%; position: relative; overflow: hidden; background: linear-gradient(135deg, #1A0545 0%, #0A2A0A 60%, #0A2E1A 100%); display: flex; flex-direction: column; justify-content: center; padding: 4rem 3.5rem;\" data-kid=\"2\">\n\n    \n    <div style=\"position: absolute; top: -120px; left: -100px; width: 450px; height: 450px; border-radius: 50%; background: radial-gradient(circle, rgba(233,30,140,0.32) 0%, transparent 70%); filter: blur(60px); pointer-events: none;\" data-kid=\"3\"></div>\n    <div style=\"position: absolute; bottom: -80px; right: -80px; width: 380px; height: 380px; border-radius: 50%; background: radial-gradient(circle, rgba(0,191,165,0.28) 0%, transparent 70%); filter: blur(55px); pointer-events: none;\" data-kid=\"4\"></div>\n    <div style=\"position: absolute; top: 40%; right: -60px; width: 300px; height: 300px; border-radius: 50%; background: radial-gradient(circle, rgba(255,107,26,0.22) 0%, transparent 70%); filter: blur(50px); pointer-events: none;\" data-kid=\"5\"></div>\n    <div style=\"position: absolute; top: 20%; left: 50%; width: 200px; height: 200px; border-radius: 50%; background: radial-gradient(circle, rgba(74,20,140,0.35) 0%, transparent 70%); filter: blur(40px); pointer-events: none;\" data-kid=\"6\"></div>\n\n    \n    <div style=\"position: relative; z-index: 2; margin-bottom: 2rem;\" data-kid=\"7\">\n      <span style=\"display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.45rem 1rem; border-radius: 999px; background: rgba(233,30,140,0.15); border: 1px solid rgba(233,30,140,0.35); color: #f472b6; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase;\" data-kid=\"8\">\n        <i class=\"ti ti-sparkles\" style=\"font-size: 0.9rem;\" data-kid=\"9\"></i>\n        Kottiar Creations\n      </span>\n    </div>\n\n    \n    <div style=\"position: relative; z-index: 2; margin-bottom: 1.5rem;\" data-kid=\"10\">\n      <h1 style=\"font-family: 'Playfair Display', serif; font-size: 3.5rem; font-weight: 800; line-height: 1.1; color: #fff; letter-spacing: -0.02em; margin: 0 0 1rem;\" data-kid=\"11\">\n        Welcome Back<br data-kid=\"12\">\n        <span style=\"background: linear-gradient(90deg, #E91E8C, #FF6B1A, #00BFA5); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;\" data-kid=\"13\">to Kottiar</span>\n      </h1>\n      <p style=\"color: rgba(255,255,255,0.65); font-size: 1.05rem; line-height: 1.75; max-width: 38rem; margin: 0;\" data-kid=\"14\">\n        Discover our exclusive handcrafted bangle collections — traditional craftsmanship reimagined for the modern celebration.\n      </p>\n    </div>\n\n    \n    <div style=\"position: relative; z-index: 2; display: flex; flex-direction: column; gap: 0.65rem; margin-bottom: 2.5rem;\" data-kid=\"15\">\n      <div style=\"display: inline-flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1.1rem; border-radius: 16px; background: rgba(255,255,255,0.06); border: 1px solid rgba(233,30,140,0.25); backdrop-filter: blur(12px); width: fit-content;\" data-kid=\"16\">\n        <span style=\"color: #E91E8C; font-size: 1rem;\" data-kid=\"17\">✦</span>\n        <span style=\"color: rgba(255,255,255,0.85); font-size: 0.88rem; font-weight: 600;\" data-kid=\"18\">Curated Collections</span>\n      </div>\n      <div style=\"display: inline-flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1.1rem; border-radius: 16px; background: rgba(255,255,255,0.06); border: 1px solid rgba(0,191,165,0.25); backdrop-filter: blur(12px); width: fit-content;\" data-kid=\"19\">\n        <span style=\"color: #00BFA5; font-size: 1rem;\" data-kid=\"20\">✦</span>\n        <span style=\"color: rgba(255,255,255,0.85); font-size: 0.88rem; font-weight: 600;\" data-kid=\"21\">Exclusive Designs</span>\n      </div>\n      <div style=\"display: inline-flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1.1rem; border-radius: 16px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,107,26,0.25); backdrop-filter: blur(12px); width: fit-content;\" data-kid=\"22\">\n        <span style=\"color: #FF6B1A; font-size: 1rem;\" data-kid=\"23\">✦</span>\n        <span style=\"color: rgba(255,255,255,0.85); font-size: 0.88rem; font-weight: 600;\" data-kid=\"24\">Wishlist & Favorites</span>\n      </div>\n    </div>\n\n    \n    <div style=\"position: relative; z-index: 2; display: flex; align-items: center; gap: 2rem;\" data-kid=\"25\">\n\n      \n      <div style=\"position: relative; width: 130px; height: 130px; flex-shrink: 0;\" data-kid=\"26\">\n        <div style=\"position: absolute; inset: 0; border-radius: 50%; border: 22px solid rgba(233,30,140,0.75); box-shadow: 0 0 28px rgba(233,30,140,0.4);\" data-kid=\"27\"></div>\n        <div style=\"position: absolute; inset: 8px 4px 4px 8px; border-radius: 50%; border: 18px solid rgba(255,107,26,0.7); box-shadow: 0 0 22px rgba(255,107,26,0.35);\" data-kid=\"28\"></div>\n        <div style=\"position: absolute; inset: 4px 8px 8px 4px; border-radius: 50%; border: 14px solid rgba(0,191,165,0.65); box-shadow: 0 0 18px rgba(0,191,165,0.3);\" data-kid=\"29\"></div>\n      </div>\n\n      \n      <div style=\"flex: 1; border-radius: 20px; overflow: hidden; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); backdrop-filter: blur(10px); position: relative;\" data-kid=\"30\">\n        <img src=\"https://images.pexels.com/photos/36406040/pexels-photo-36406040.jpeg?auto=compress&cs=tinysrgb&w=600&q=80\" alt=\"Colorful Indian bangles — Neha Parganihaa on Pexels\" decoding=\"async\" loading=\"lazy\" style=\"width: 100%; height: 180px; object-fit: cover; display: block; opacity: 0.88;\" data-kid=\"31\">\n        <div style=\"position: absolute; inset: 0; background: linear-gradient(to top, rgba(10,2,30,0.55) 0%, transparent 55%);\" data-kid=\"32\"></div>\n        <div style=\"position: absolute; bottom: 0.75rem; left: 0.75rem; right: 0.75rem;\" data-kid=\"33\">\n          <span style=\"display: inline-block; font-size: 0.75rem; color: rgba(255,255,255,0.75); font-weight: 500;\" data-kid=\"34\">Premium handcrafted bangles</span>\n        </div>\n      </div>\n    </div>\n\n    \n    <div style=\"position: relative; z-index: 2; margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid rgba(255,255,255,0.08);\" data-kid=\"35\">\n      <p style=\"color: rgba(255,255,255,0.35); font-size: 0.78rem; letter-spacing: 0.05em; text-transform: uppercase;\" data-kid=\"36\">Est. Kottiar Creations · Handcrafted with love</p>\n    </div>\n  </div>\n\n  \n  <div style=\"width: 45%; display: flex; align-items: center; justify-content: center; padding: 3rem 3rem; background: rgba(255,255,255,0.03); position: relative; overflow: hidden;\" data-kid=\"37\">\n\n    \n    <div style=\"position: absolute; top: -60px; right: -60px; width: 280px; height: 280px; border-radius: 50%; background: radial-gradient(circle, rgba(74,20,140,0.3) 0%, transparent 70%); filter: blur(50px); pointer-events: none;\" data-kid=\"38\"></div>\n    <div style=\"position: absolute; bottom: -60px; left: -40px; width: 240px; height: 240px; border-radius: 50%; background: radial-gradient(circle, rgba(0,191,165,0.15) 0%, transparent 70%); filter: blur(45px); pointer-events: none;\" data-kid=\"39\"></div>\n\n    <div style=\"width: 100%; max-width: 420px; position: relative; z-index: 2;\" data-kid=\"40\">\n\n      \n      <div style=\"display: flex; align-items: center; gap: 0.75rem; margin-bottom: 2rem;\" data-kid=\"41\">\n        <img src=\"/api/local/images/public/logo/Kottiar creations logo.jpeg\" alt=\"Kottiar Creations\" decoding=\"async\" loading=\"lazy\" style=\"height: 64px; width: auto; border-radius: 10px; object-fit: contain; border: 1px solid rgba(255,255,255,0.12);\" data-kid=\"42\">\n        <div data-kid=\"43\">\n          <div style=\"font-family: 'Playfair Display', serif; color: #fff; font-weight: 700; font-size: 1.1rem; line-height: 1.2;\" data-kid=\"44\">KottiarCatalog</div>\n          <div style=\"color: rgba(255,255,255,0.45); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em;\" data-kid=\"45\">Premium Bangles</div>\n        </div>\n      </div>\n\n      \n      <div style=\"margin-bottom: 0.6rem;\" data-kid=\"46\">\n        <span style=\"display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.35rem 0.85rem; border-radius: 999px; background: rgba(233,30,140,0.12); border: 1px solid rgba(233,30,140,0.28); color: #f472b6; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase;\" data-kid=\"47\">\n          <i class=\"ti ti-lock\" style=\"font-size: 0.75rem;\" data-kid=\"48\"></i>\n          Account Access\n        </span>\n      </div>\n\n      \n      <h2 style=\"font-family: 'Playfair Display', serif; font-size: 2.4rem; font-weight: 700; color: #fff; line-height: 1.1; margin: 0 0 0.5rem; letter-spacing: -0.02em;\" data-kid=\"49\">Sign in</h2>\n      <p style=\"color: rgba(255,255,255,0.5); font-size: 0.9rem; line-height: 1.6; margin: 0 0 1.75rem;\" data-kid=\"50\">Use your email and password to enter KottiarCatalog.</p>\n\n      \n      <button style=\"width: 100%; display: flex; align-items: center; justify-content: center; gap: 0.65rem; padding: 0.85rem 1.5rem; border-radius: 14px; border: 1px solid rgba(255,255,255,0.18); background: rgba(255,255,255,0.95); color: #1a1a2e; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.92rem; font-weight: 600; cursor: pointer; margin-bottom: 1.25rem; transition: all 0.2s;\" data-kid=\"51\">\n        <span style=\"display: flex; align-items: center; justify-content: center; width: 22px; height: 22px; background: #fff; border-radius: 50%; box-shadow: 0 0 0 1px rgba(0,0,0,0.08);\" data-kid=\"52\">\n          <i class=\"ti ti-brand-google\" style=\"font-size: 0.95rem; color: #4285F4;\" data-kid=\"53\"></i>\n        </span>\n        Continue with Google\n      </button>\n\n      \n      <div style=\"display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 0.75rem; margin-bottom: 1.25rem;\" data-kid=\"54\">\n        <div style=\"height: 1px; background: rgba(255,255,255,0.1);\" data-kid=\"55\"></div>\n        <span style=\"color: rgba(255,255,255,0.35); font-size: 0.78rem; font-weight: 600; letter-spacing: 0.06em; white-space: nowrap;\" data-kid=\"56\">— or use email —</span>\n        <div style=\"height: 1px; background: rgba(255,255,255,0.1);\" data-kid=\"57\"></div>\n      </div>\n\n      \n      <div style=\"margin-bottom: 1rem;\" data-kid=\"58\">\n        <label style=\"display: block; margin-bottom: 0.4rem; color: rgba(255,255,255,0.6); font-size: 0.82rem; font-weight: 600; letter-spacing: 0.02em;\" data-kid=\"59\">Email address</label>\n        <div style=\"position: relative;\" data-kid=\"60\">\n          <div style=\"position: absolute; left: 0.9rem; top: 50%; transform: translateY(-50%); color: rgba(255,255,255,0.3); pointer-events: none;\" data-kid=\"61\">\n            <i class=\"ti ti-mail\" style=\"font-size: 1rem;\" data-kid=\"62\"></i>\n          </div>\n          <input type=\"email\" placeholder=\"hello@kottiar.in\" style=\"width: 100%; padding: 0.85rem 1rem 0.85rem 2.75rem; border-radius: 12px; border: 1px solid rgba(255,255,255,0.12); background: rgba(255,255,255,0.06); color: #fff; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.9rem; outline: none; box-sizing: border-box;\" data-kid=\"63\">\n        </div>\n      </div>\n\n      \n      <div style=\"margin-bottom: 1.5rem;\" data-kid=\"64\">\n        <label style=\"display: block; margin-bottom: 0.4rem; color: rgba(255,255,255,0.6); font-size: 0.82rem; font-weight: 600; letter-spacing: 0.02em;\" data-kid=\"65\">Password</label>\n        <div style=\"position: relative;\" data-kid=\"66\">\n          <div style=\"position: absolute; left: 0.9rem; top: 50%; transform: translateY(-50%); color: rgba(255,255,255,0.3); pointer-events: none;\" data-kid=\"67\">\n            <i class=\"ti ti-lock\" style=\"font-size: 1rem;\" data-kid=\"68\"></i>\n          </div>\n          <input type=\"password\" placeholder=\"Enter your password\" style=\"width: 100%; padding: 0.85rem 1rem 0.85rem 2.75rem; border-radius: 12px; border: 1px solid rgba(255,255,255,0.12); background: rgba(255,255,255,0.06); color: #fff; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.9rem; outline: none; box-sizing: border-box;\" data-kid=\"69\">\n        </div>\n      </div>\n\n      \n      <button style=\"width: 100%; padding: 0.95rem 1.5rem; border-radius: 14px; border: none; background: linear-gradient(135deg, #E91E8C 0%, #FF6B1A 100%); color: #fff; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.95rem; font-weight: 700; cursor: pointer; margin-bottom: 0.75rem; letter-spacing: 0.02em; box-shadow: 0 8px 24px rgba(233,30,140,0.35);\" data-kid=\"70\">\n        <i class=\"ti ti-arrow-right\" style=\"margin-right: 0.4rem;\" data-kid=\"71\"></i>\n        Enter catalog\n      </button>\n\n      \n      <button style=\"width: 100%; padding: 0.85rem 1.5rem; border-radius: 14px; border: 1px solid rgba(255,255,255,0.15); background: rgba(255,255,255,0.06); color: rgba(255,255,255,0.7); font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.9rem; font-weight: 600; cursor: pointer; backdrop-filter: blur(8px);\" data-kid=\"72\">\n        Continue as guest\n      </button>\n\n      \n      <p style=\"text-align: center; margin-top: 1.5rem; color: rgba(255,255,255,0.4); font-size: 0.88rem;\" data-kid=\"73\">\n        New here?&nbsp;<a href=\"#\" style=\"color: #00BFA5; font-weight: 700; text-decoration: none;\" data-kid=\"74\">Create an account</a>\n      </p>\n\n    </div>\n  </div>\n\n</div>\n",
