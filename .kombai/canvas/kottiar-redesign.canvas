      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,900;1,400;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n\n  .kc-root {\n    font-family: 'Plus Jakarta Sans', sans-serif;\n    background: linear-gradient(135deg, #0D0221 0%, #1A0545 40%, #0A2E1A 100%);\n    color: #fff;\n    position: relative;\n    overflow: hidden;\n  }\n\n  /* Ambient orbs */\n  .orb {\n    position: absolute;\n    border-radius: 50%;\n    pointer-events: none;\n    filter: blur(90px);\n    z-index: 0;\n  }\n  .orb-1 { width: 700px; height: 700px; top: -200px; left: -200px; background: radial-gradient(circle, rgba(233,30,140,0.28) 0%, transparent 70%); }\n  .orb-2 { width: 600px; height: 600px; top: 200px; right: -150px; background: radial-gradient(circle, rgba(0,191,165,0.22) 0%, transparent 70%); }\n  .orb-3 { width: 500px; height: 500px; bottom: 200px; left: 25%; background: radial-gradient(circle, rgba(74,20,140,0.32) 0%, transparent 70%); }\n  .orb-4 { width: 400px; height: 400px; bottom: -100px; right: 20%; background: radial-gradient(circle, rgba(255,107,26,0.18) 0%, transparent 70%); }\n\n  /* Glass util */\n  .glass {\n    background: rgba(255,255,255,0.07);\n    backdrop-filter: blur(20px);\n    -webkit-backdrop-filter: blur(20px);\n    border: 1px solid rgba(255,255,255,0.12);\n  }\n\n  /* ======= NAV ======= */\n  .nav {\n    position: relative;\n    z-index: 100;\n    padding: 1rem 4rem;\n    background: rgba(10,5,30,0.85);\n    backdrop-filter: blur(18px);\n    -webkit-backdrop-filter: blur(18px);\n    border-bottom: 1px solid rgba(255,255,255,0.08);\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n  }\n  .nav-logo {\n    display: flex;\n    align-items: center;\n    gap: 0.75rem;\n    font-family: 'Playfair Display', serif;\n    font-weight: 700;\n    font-size: 1.25rem;\n    letter-spacing: -0.02em;\n    color: #fff;\n    text-decoration: none;\n  }\n  .nav-logo-img {\n    width: 48px;\n    height: 48px;\n    border-radius: 10px;\n    object-fit: cover;\n    border: 1px solid rgba(233,30,140,0.3);\n    box-shadow: 0 0 16px rgba(233,30,140,0.25);\n  }\n  .nav-actions { display: flex; gap: 0.75rem; align-items: center; }\n  .btn-ghost-nav {\n    padding: 0.6rem 1.4rem;\n    border-radius: 999px;\n    background: rgba(255,255,255,0.07);\n    border: 1px solid rgba(255,255,255,0.18);\n    color: rgba(255,255,255,0.85);\n    font-family: 'Plus Jakarta Sans', sans-serif;\n    font-weight: 600;\n    font-size: 0.875rem;\n    cursor: pointer;\n    text-decoration: none;\n    transition: all 0.2s;\n  }\n  .btn-gradient-nav {\n    padding: 0.6rem 1.4rem;\n    border-radius: 999px;\n    background: linear-gradient(135deg, #E91E8C 0%, #FF6B1A 100%);\n    border: none;\n    color: #fff;\n    font-family: 'Plus Jakarta Sans', sans-serif;\n    font-weight: 700;\n    font-size: 0.875rem;\n    cursor: pointer;\n    text-decoration: none;\n    box-shadow: 0 4px 18px rgba(233,30,140,0.35);\n  }\n\n  /* ======= HERO ======= */\n  .hero {\n    position: relative;\n    z-index: 1;\n    display: grid;\n    grid-template-columns: 1.1fr 0.9fr;\n    gap: 3rem;\n    align-items: center;\n    padding: 6rem 4rem 6rem;\n    min-height: 680px;\n  }\n  .hero-copy { display: flex; flex-direction: column; gap: 1.5rem; }\n  .hero-eyebrow {\n    display: inline-flex;\n    align-items: center;\n    gap: 0.5rem;\n    padding: 0.45rem 1rem;\n    border-radius: 999px;\n    background: rgba(233,30,140,0.15);\n    border: 1px solid rgba(233,30,140,0.35);\n    color: #FF6B8A;\n    font-size: 0.78rem;\n    font-weight: 700;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n    width: fit-content;\n  }\n  .hero-title {\n    font-family: 'Playfair Display', serif;\n    font-size: clamp(3.5rem, 5.5vw, 6.5rem);\n    font-weight: 900;\n    line-height: 1.0;\n    letter-spacing: -0.03em;\n    color: #fff;\n  }\n  .hero-title span {\n    background: linear-gradient(135deg, #E91E8C 0%, #FF6B1A 60%, #FFD700 100%);\n    -webkit-background-clip: text;\n    background-clip: text;\n    -webkit-text-fill-color: transparent;\n  }\n  .hero-subtitle {\n    font-size: 1.1rem;\n    color: rgba(255,255,255,0.65);\n    line-height: 1.75;\n    max-width: 38rem;\n  }\n  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 0.5rem; }\n  .btn-primary-hero {\n    display: inline-flex;\n    align-items: center;\n    gap: 0.5rem;\n    padding: 0.95rem 2.2rem;\n    border-radius: 999px;\n    background: linear-gradient(135deg, #E91E8C 0%, #FF6B1A 100%);\n    border: none;\n    color: #fff;\n    font-family: 'Plus Jakarta Sans', sans-serif;\n    font-weight: 700;\n    font-size: 1rem;\n    cursor: pointer;\n    text-decoration: none;\n    box-shadow: 0 8px 32px rgba(233,30,140,0.45), 0 2px 8px rgba(255,107,26,0.25);\n  }\n  .btn-secondary-hero {\n    display: inline-flex;\n    align-items: center;\n    gap: 0.5rem;\n    padding: 0.95rem 2.2rem;\n    border-radius: 999px;\n    background: rgba(255,255,255,0.08);\n    border: 1px solid rgba(255,255,255,0.22);\n    color: rgba(255,255,255,0.9);\n    font-family: 'Plus Jakarta Sans', sans-serif;\n    font-weight: 600;\n    font-size: 1rem;\n    cursor: pointer;\n    text-decoration: none;\n    backdrop-filter: blur(12px);\n  }\n  .hero-stats {\n    display: flex;\n    gap: 2.5rem;\n    margin-top: 0.5rem;\n    padding-top: 1.5rem;\n    border-top: 1px solid rgba(255,255,255,0.1);\n  }\n  .hero-stat strong {\n    display: block;\n    font-family: 'Playfair Display', serif;\n    font-size: 2rem;\n    font-weight: 700;\n    background: linear-gradient(135deg, #E91E8C, #FF6B1A);\n    -webkit-background-clip: text;\n    background-clip: text;\n    -webkit-text-fill-color: transparent;\n  }\n  .hero-stat span {\n    font-size: 0.8rem;\n    color: rgba(255,255,255,0.5);\n    font-weight: 500;\n    text-transform: uppercase;\n    letter-spacing: 0.08em;\n  }\n\n  /* ======= HERO VISUAL ======= */\n  .hero-visual {\n    position: relative;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    height: 520px;\n  }\n  .bangle-stack {\n    position: relative;\n    width: 380px;\n    height: 380px;\n    flex-shrink: 0;\n  }\n  .bangle-stack span {\n    position: absolute;\n    border-radius: 50%;\n  }\n  .bangle-stack span:nth-child(1) {\n    inset: 0;\n    border: 48px solid #E91E8C;\n    opacity: 0.85;\n    box-shadow: 0 0 60px rgba(233,30,140,0.5), inset 0 0 30px rgba(233,30,140,0.2);\n  }\n  .bangle-stack span:nth-child(2) {\n    inset: 55px 10px 10px 55px;\n    border: 40px solid #00BFA5;\n    opacity: 0.8;\n    box-shadow: 0 0 50px rgba(0,191,165,0.45), inset 0 0 20px rgba(0,191,165,0.15);\n  }\n  .bangle-stack span:nth-child(3) {\n    inset: 10px 55px 55px 10px;\n    border: 36px solid #FF6B1A;\n    opacity: 0.8;\n    box-shadow: 0 0 50px rgba(255,107,26,0.45), inset 0 0 20px rgba(255,107,26,0.15);\n  }\n  .hero-img-float {\n    position: absolute;\n    bottom: 10px;\n    right: 0;\n    width: 240px;\n    height: 320px;\n    border-radius: 24px;\n    overflow: hidden;\n    border: 1px solid rgba(255,255,255,0.15);\n    box-shadow: 0 24px 60px rgba(0,0,0,0.4), 0 0 40px rgba(233,30,140,0.2);\n  }\n  .hero-img-float img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n  }\n  .hero-img-pill {\n    position: absolute;\n    top: 20px;\n    right: 30px;\n    padding: 0.6rem 1rem;\n    border-radius: 999px;\n    background: rgba(233,30,140,0.2);\n    backdrop-filter: blur(12px);\n    border: 1px solid rgba(233,30,140,0.35);\n    color: #FFB3D1;\n    font-size: 0.78rem;\n    font-weight: 700;\n    display: flex;\n    align-items: center;\n    gap: 0.4rem;\n  }\n\n  /* ======= COLLECTIONS ======= */\n  .collections {\n    position: relative;\n    z-index: 1;\n    padding: 4rem 4rem;\n  }\n  .section-eyebrow {\n    text-align: center;\n    margin-bottom: 0.75rem;\n  }\n  .section-eyebrow span {\n    display: inline-flex;\n    align-items: center;\n    gap: 0.4rem;\n    padding: 0.4rem 1rem;\n    border-radius: 999px;\n    background: rgba(255,255,255,0.07);\n    border: 1px solid rgba(255,255,255,0.14);\n    color: rgba(255,255,255,0.6);\n    font-size: 0.75rem;\n    font-weight: 700;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n  }\n  .section-title {\n    font-family: 'Playfair Display', serif;\n    font-size: 2.6rem;\n    font-weight: 700;\n    text-align: center;\n    color: #fff;\n    margin-bottom: 2.5rem;\n    letter-spacing: -0.03em;\n  }\n  .collections-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 1.5rem;\n  }\n  .collection-card {\n    border-radius: 28px;\n    overflow: hidden;\n    position: relative;\n    height: 380px;\n    display: flex;\n    flex-direction: column;\n    justify-content: flex-end;\n    padding: 2rem;\n    transition: transform 0.3s ease, box-shadow 0.3s ease;\n  }\n  .collection-card:hover { transform: translateY(-6px); }\n  .collection-card-emerald {\n    background: linear-gradient(160deg, #00473A 0%, #00897B 50%, #4CAF50 100%);\n    box-shadow: 0 16px 48px rgba(0,137,123,0.35);\n  }\n  .collection-card-fuchsia {\n    background: linear-gradient(160deg, #5D006E 0%, #AD1457 50%, #E91E8C 100%);\n    box-shadow: 0 16px 48px rgba(233,30,140,0.35);\n  }\n  .collection-card-saffron {\n    background: linear-gradient(160deg, #7B3700 0%, #E65100 50%, #FF6B1A 100%);\n    box-shadow: 0 16px 48px rgba(255,107,26,0.35);\n  }\n  .collection-card-img {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    opacity: 0.35;\n  }\n  .collection-card-overlay {\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(to top, rgba(0,0,0,0.75) 0%, tra